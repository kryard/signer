# Kryard dashboard — local development environment.
#
# Copy this file to `.env.local` (git-ignored) to enable zero-auth localhost
# mode. In this mode the dashboard talks DIRECTLY to a locally running Kryard
# API with NO Cloudflare Access and NO admin token — ideal for OSS contributors.
#
#   cp .env.example .env.local
#   npm run dev        # Vite dev server on http://localhost:5173
#
# Then run the API locally (in services/api) listening on VITE_API_BASE below.

# Turn on zero-auth localhost mode. When unset/false the dashboard expects to be
# served by the kryard-app Cloudflare Worker (same-origin /api proxy + token).
VITE_LOCAL=true

# Base URL of your local Kryard API. The dashboard hits <VITE_API_BASE>/admin/dev/*
# directly. Default matches `wrangler dev` for services/api.
VITE_API_BASE=http://localhost:8787
