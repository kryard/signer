{
  "name": "kryard-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Kryard console worker — serves the SPA + a same-origin proxy to the
  // Kryard API. Put Cloudflare Access (SSO) on this route when deploying.
  //
  // Configuration (set these for YOUR deployment):
  //   - API_BASE: the base URL of your Kryard API. Defaults below to a
  //     localhost dev value — override it for a real deployment, e.g. via
  //     `wrangler deploy --var API_BASE:https://api.example.com` or your own
  //     wrangler.<env>.jsonc. Do NOT commit account-specific hostnames here.
  //   - DEV_ADMIN_TOKEN: a deploy-time SECRET injected server-side on
  //     /api/admin/* calls (the browser never sees it). NEVER commit it.
  //     Set it with: `wrangler secret put DEV_ADMIN_TOKEN`.
  //
  // For zero-auth LOCAL development you don't need this worker at all — run
  // `npm run dev` (Vite) with VITE_LOCAL=true and talk to the local API
  // directly. See .env.example and README.md.
  //
  // Not reachable at *.workers.dev — only via a custom domain (which should sit
  // behind Access). Avoids an unauthenticated signing console on a public URL.
  "workers_dev": false,
  // The Vite-built SPA is served from ./dist with SPA fallback; only /api/* and
  // /healthz reach the worker script (same-origin proxy with server-side token
  // injection — see src/worker/index.ts).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    // Placeholder default — override per deployment. No account-specific host.
    "API_BASE": "http://localhost:8787"
  }
}
