{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "migrations"]
}
